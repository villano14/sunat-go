<?xml version="1.0" encoding="UTF-8"?>
<Retention xmlns="urn:sunat:names:specification:ubl:peru:schema:xsd:Retention-1" xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2" xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2" xmlns:sac="urn:sunat:names:specification:ubl:peru:schema:xsd:SunatAggregateComponents-1">
  <ext:UBLExtensions>
    <ext:UBLExtension>
      <ext:ExtensionContent/>
    </ext:UBLExtension>
  </ext:UBLExtensions>
  <cbc:UBLVersionID>2.0</cbc:UBLVersionID>
  <cbc:CustomizationID>1.0</cbc:CustomizationID>
  <cac:Signature>
    <cbc:ID>SIGN{{x .Company.RUC}}</cbc:ID>
    <cac:SignatoryParty>
      <cac:PartyIdentification>
        <cbc:ID>{{x .Company.RUC}}</cbc:ID>
      </cac:PartyIdentification>
      <cac:PartyName>
        <cbc:Name>{{x .Company.LegalName}}</cbc:Name>
      </cac:PartyName>
    </cac:SignatoryParty>
    <cac:DigitalSignatureAttachment>
      <cac:ExternalReference>
        <cbc:URI>#{{.SignatureID}}</cbc:URI>
      </cac:ExternalReference>
    </cac:DigitalSignatureAttachment>
  </cac:Signature>
  <cbc:ID>{{x .ID}}</cbc:ID>
  <cbc:IssueDate>{{date .IssueDate}}</cbc:IssueDate>
  <cbc:IssueTime>{{time .IssueDate}}</cbc:IssueTime>
  <cac:AgentParty>
    <cac:PartyIdentification>
      <cbc:ID schemeID="6">{{x .Company.RUC}}</cbc:ID>
    </cac:PartyIdentification>
    <cac:PartyName>
      <cbc:Name>{{x (def .Company.TradeName .Company.LegalName)}}</cbc:Name>
    </cac:PartyName>
{{- with .Company.Address}}
    <cac:PostalAddress>
      <cbc:ID>{{x .Ubigeo}}</cbc:ID>
      <cbc:StreetName>{{x .Line}}</cbc:StreetName>
      <cbc:CityName>{{x .Department}}</cbc:CityName>
      <cbc:CountrySubentity>{{x .Province}}</cbc:CountrySubentity>
      <cbc:District>{{x .District}}</cbc:District>
      <cac:Country>
        <cbc:IdentificationCode>{{x (def .CountryCode "PE")}}</cbc:IdentificationCode>
      </cac:Country>
    </cac:PostalAddress>
{{- end}}
    <cac:PartyLegalEntity>
      <cbc:RegistrationName>{{x .Company.LegalName}}</cbc:RegistrationName>
    </cac:PartyLegalEntity>
  </cac:AgentParty>
  <cac:ReceiverParty>
    <cac:PartyIdentification>
      <cbc:ID schemeID="{{x (print .Party.IdentityType)}}">{{x .Party.Number}}</cbc:ID>
    </cac:PartyIdentification>
    <cac:PartyLegalEntity>
      <cbc:RegistrationName>{{x .Party.Name}}</cbc:RegistrationName>
    </cac:PartyLegalEntity>
  </cac:ReceiverParty>
  <sac:SUNATRetentionSystemCode>{{x .Regime}}</sac:SUNATRetentionSystemCode>
  <sac:SUNATRetentionPercent>{{amt .Rate}}</sac:SUNATRetentionPercent>
{{- if .Note}}
  <cbc:Note>{{x .Note}}</cbc:Note>
{{- end}}
  <cbc:TotalInvoiceAmount currencyID="PEN">{{amt .Total}}</cbc:TotalInvoiceAmount>
  <sac:SUNATTotalPaid currencyID="PEN">{{amt .Settled}}</sac:SUNATTotalPaid>
{{- range .Details}}
  <sac:SUNATRetentionDocumentReference>
    <cbc:ID schemeID="{{x (print .DocumentType)}}">{{x .Number}}</cbc:ID>
    <cbc:IssueDate>{{date .IssueDate}}</cbc:IssueDate>
    <cbc:TotalInvoiceAmount currencyID="{{x .Currency}}">{{amt .Total}}</cbc:TotalInvoiceAmount>
{{- range $i, $p := .Payments}}
    <cac:Payment>
      <cbc:ID>{{add1 $i}}</cbc:ID>
      <cbc:PaidAmount currencyID="{{x $p.Currency}}">{{amt $p.Amount}}</cbc:PaidAmount>
      <cbc:PaidDate>{{date $p.Date}}</cbc:PaidDate>
    </cac:Payment>
{{- end}}
{{- if .HasInfo}}
    <sac:SUNATRetentionInformation>
      <sac:SUNATRetentionAmount currencyID="PEN">{{amt .InfoAmount}}</sac:SUNATRetentionAmount>
      <sac:SUNATRetentionDate>{{date .InfoDate}}</sac:SUNATRetentionDate>
      <sac:SUNATNetTotalPaid currencyID="PEN">{{amt .InfoNet}}</sac:SUNATNetTotalPaid>
{{- with .Exchange}}
      <cac:ExchangeRate>
        <cbc:SourceCurrencyCode>{{x .SourceCurrency}}</cbc:SourceCurrencyCode>
        <cbc:TargetCurrencyCode>{{x .TargetCurrency}}</cbc:TargetCurrencyCode>
        <cbc:CalculationRate>{{.Factor}}</cbc:CalculationRate>
        <cbc:Date>{{date .Date}}</cbc:Date>
      </cac:ExchangeRate>
{{- end}}
    </sac:SUNATRetentionInformation>
{{- end}}
  </sac:SUNATRetentionDocumentReference>
{{- end}}
</Retention>
